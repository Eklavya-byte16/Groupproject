# --- app ---
APP_NAME=backend
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# --- database ---
# Local dev fallback (no Docker): sqlite:///./dev.db
# Docker/production: postgresql+psycopg2://<user>:<password>@db:5432/<dbname>
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/app

# --- auth / jwt ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- first-run bootstrap admin (central body) ---
# Only used once by `python -m scripts.seed_admin`. Change the password
# on first login, then you can safely leave/rotate this value.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

TEMP_PASSWORD_LENGTH=12

# --- smtp (real provider - Gmail/SES/SendGrid/etc) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME="Admin Team"

# --- celery / redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- frontend (used inside emails for the login link) ---
FRONTEND_BASE_URL=http://localhost:5173
